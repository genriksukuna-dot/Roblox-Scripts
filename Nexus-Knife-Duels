    Alive = false
    TeamDebugClock = 0
    disconnectAll()
    for plr in pairs(Hitboxes) do removeHitbox(plr) end
    clearDrawings()
    for plr in pairs(espEntries) do destroyEspEntry(plr) end
    pcall(function() RunService:UnbindFromRenderStep("NEXUS_KNIFE_AIM") end)
    safeDestroy(Gui)
    safeDestroy(ESPGui)
    GLOBAL.__LOADED = false
end

