local function removeHitbox(plr)
    local part = Hitboxes[plr]
    if part then safeDestroy(part) end
    Hitboxes[plr] = nil
end

local function ensureHitbox(plr)
    if not Settings.ESP.Hitbox or not validTarget(plr, Settings.ESP.TeamCheck) then
        removeHitbox(plr)
        return nil
    end
    local char = plr.Character
    local root = getRoot(plr)
    if not char or not root then
        removeHitbox(plr)
        return nil
    end
    local h = Hitboxes[plr]
    if not h or not h.Parent then
        h = Instance.new("Part")
        h.Name = "NexusTargetHitbox"
        h.Shape = Enum.PartType.Ball
        h.Anchored = false
        h.CanCollide = false
        h.CanTouch = false
        h.CanQuery = true
        h.Massless = true
        h.CastShadow = false
        h.Material = Enum.Material.ForceField
        local relation = "unknown"
        local okRelation, resolved = pcall(getTeamRelation, plr)
        if okRelation then relation = resolved end
        h.Color = relation == "ally" and Color3.fromRGB(80, 255, 130)
            or relation == "enemy" and Color3.fromRGB(255, 75, 75)
            or Color3.fromRGB(255, 255, 255)
        h.Transparency = Settings.ESP.HitboxTransparency
        h.Size = Vector3.new(Settings.ESP.HitboxSize, Settings.ESP.HitboxSize, Settings.ESP.HitboxSize)
        h.Parent = char
        local weld = Instance.new("WeldConstraint")
        weld.Part0 = root
        weld.Part1 = h
        weld.Parent = h
        h.CFrame = root.CFrame
        Hitboxes[plr] = h
    else
        h.Size = Vector3.new(Settings.ESP.HitboxSize, Settings.ESP.HitboxSize, Settings.ESP.HitboxSize)
        h.Transparency = Settings.ESP.HitboxTransparency
        local relation = "unknown"
        local okRelation, resolved = pcall(getTeamRelation, plr)
        if okRelation then relation = resolved end
        h.Color = relation == "ally" and Color3.fromRGB(80, 255, 130)
            or relation == "enemy" and Color3.fromRGB(255, 75, 75)
            or Color3.fromRGB(255, 255, 255)
    end
    return h
end

