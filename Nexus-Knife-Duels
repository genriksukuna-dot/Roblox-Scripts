local function renderEsp()
    refreshEspHealthCache(false)
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local e = addEspEntry(plr)
            local char = plr.Character
            local root = getRoot(plr)
            local hum = getHumanoid(char)
            local healthData = EspHealthCache.data[plr] or {}
            local hpNow, maxHpNow = healthData.hp, healthData.max
            local customDead, foundCustom = healthData.dead == true, healthData.found == true
            -- validTarget() is the authoritative life/ghost check. The cached
            -- custom HP flag is display data only; treating it as a hard ESP
            -- gate caused the first round to disappear while the HUD HP was
            -- still being initialized.
            local valid = Settings.ESP.Enabled and validTarget(plr, Settings.ESP.TeamCheck) and root and root.Parent and char.Parent
            if valid then
                local rootPos, rootOn, rootZ = worldToScreen(root.Position)
                local distance = (root.Position - Camera.CFrame.Position).Magnitude
                if rootOn and rootZ > 0 and distance <= Settings.ESP.MaxDistance then
                    -- Team resolver must never be able to disable ESP when Team
                    -- Check is OFF. During round one the HUD may still be
                    -- initializing; ESP visibility is based on the character,
                    -- not on asynchronous team discovery.
                    local relation = "unknown"
                    if Settings.ESP.TeamCheck then
                        local okRelation, resolved = pcall(getTeamRelation, plr)
                        relation = okRelation and resolved or "unknown"
                        if relation ~= "enemy" then
                            hideEsp(e)
                            ensureHitbox(plr)
                            continue
                        end
                    else
                        -- Color is best-effort only when Team Check is OFF.
                        -- Even if this resolver is unavailable in round one,
                        -- the player remains visible in ESP.
                        local okRelation, resolved = pcall(getTeamRelation, plr)
                        if okRelation and (resolved == "ally" or resolved == "enemy") then
                            relation = resolved
                        end
                    end
                    local teamColor = relation == "ally" and Color3.fromRGB(80, 255, 130)
                        or relation == "enemy" and Color3.fromRGB(255, 75, 75)
                        or Color3.fromRGB(255, 255, 255)
                    if e.name then
                        e.name.Visible = Settings.ESP.Name
                        e.name.Position = UDim2.fromOffset(rootPos.X, rootPos.Y - 42)
                        e.name.Text = plr.DisplayName ~= plr.Name and (plr.DisplayName .. "  @" .. plr.Name) or plr.Name
                        e.name.TextColor3 = teamColor
                        e.name.ZIndex = 100
                    end
                    if e.health then
                        e.health.Visible = Settings.ESP.Health and not customDead
                        e.health.Position = UDim2.fromOffset(rootPos.X, rootPos.Y - 27)
                        if hpNow ~= nil and maxHpNow ~= nil and foundCustom then
                            local hp = math.max(0, hpNow)
                            local maxHp = math.max(1, maxHpNow)
                            e.health.Text = string.format("HP %d/%d  •  %dm", math.floor(hp+0.5), math.floor(maxHp+0.5), math.floor(distance))
                            local ratio = math.clamp(hp / maxHp, 0, 1)
                            e.health.TextColor3 = ratio > 0.35 and Color3.fromRGB(118,240,151) or Color3.fromRGB(255,110,110)
                        else
                            e.health.Text = string.format("HP ?  •  %dm", math.floor(distance))
                            e.health.TextColor3 = Color3.fromRGB(190,195,210)
                        end
                        e.health.ZIndex = 100
                    end
                    if e.line then
                        if Settings.ESP.Line then
                            setScreenLine(e.line, center, rootPos, 1, teamColor)
                        else
                            e.line.Visible = false
                        end
                        e.line.ZIndex = 99
                    end
                    for _, bone in ipairs(e.bones) do
                        local a, b = char:FindFirstChild(bone.a), char:FindFirstChild(bone.b)
                        if Settings.ESP.Skeleton and a and b and a:IsA("BasePart") and b:IsA("BasePart") then
                            local pa, oa, za = worldToScreen(a.Position)
                            local pb, ob, zb = worldToScreen(b.Position)
                            if oa and ob and za > 0 and zb > 0 then
                                setScreenLine(bone.drawing, pa, pb, 1, teamColor)
                            else
                                bone.drawing.Visible = false
                            end
                            bone.drawing.ZIndex = 98
                        else
                            bone.drawing.Visible = false
                        end
                    end
                    ensureHitbox(plr)
                else
                    hideEsp(e)
                    ensureHitbox(plr)
                end
            else
                hideEsp(e)
                ensureHitbox(plr)
            end
        end
    end
end

local function updateFOV()
    if not FOVCircle then return end
    local diameter = math.max(2, Settings.AIM.FOV * 2)
    FOVCircle.Size = UDim2.fromOffset(diameter, diameter)
    FOVCircle.Position = UDim2.fromOffset(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    FOVStroke.Color = Settings.UI.Accent
    FOVCircle.Visible = Settings.AIM.Enabled and Settings.AIM.ShowFOV
end

local function lockStillValid()
    local target = AimTarget
    if not target or target == LocalPlayer then return false end
    if not target.Parent then return false end
    if isLikelyDeadOrGhost(target) then return false end
    if not validTarget(target, Settings.AIM.TeamCheck) then return false end

    -- Sticky lock is about the current target's life/availability, not FOV.
    local char = target.Character
    local root = getRoot(target)
    if not char or not char.Parent or not root or not root.Parent then return false end

    local hum = getHumanoid(char)
    if hum and hum:GetState() == Enum.HumanoidStateType.Dead then return false end
    local dead = false
    pcall(function()
        dead = char:GetAttribute("Dead") == true
            or char:GetAttribute("Died") == true
            or char:GetAttribute("Eliminated") == true
            or target:GetAttribute("Dead") == true
            or target:GetAttribute("Died") == true
            or target:GetAttribute("Eliminated") == true
    end)
    return not dead
end

local AimAcquireClock = 0
local function aimStep(dt)
    if not Settings.AIM.Enabled then
        AimTarget = nil
        return
    end
    if not Camera then return end

    AimAcquireClock += dt or 0
    -- Team/scoreboard discovery is throttled; camera tracking itself remains
    -- at render rate. This avoids mobile FPS loss and still refreshes all enemies.
    if AimAcquireClock >= 0.20 then
        AimAcquireClock = 0
        refreshTeamCache(false)
        startHudTeamRefresh(false)
        refreshVisualTeamCache(false)

        -- Acquire once; sticky mode keeps the same confirmed enemy until they
        -- are actually eliminated/removed.
        if not Settings.AIM.StickyLock then
            AimTarget = getClosestTarget(Settings.AIM.MaxDistance, Settings.AIM.FOV, Settings.AIM.TeamCheck, Settings.AIM.WallCheck)
        elseif not lockStillValid() then
            AimTarget = getClosestTarget(Settings.AIM.MaxDistance, Settings.AIM.FOV, Settings.AIM.TeamCheck, Settings.AIM.WallCheck)
        elseif Settings.AIM.SmartSwitch then
            -- Keep the current lock, but allow a real retarget when another
            -- confirmed enemy is clearly closer to the crosshair. This avoids
            -- getting stuck on the first enemy forever in 2v2/3v3/4v4 rounds.
            local currentDelta = getTargetScreenDistance(AimTarget)
            local challenger, challengerDelta = getSmartChallenger(AimTarget)
            local margin = tonumber(Settings.AIM.SwitchMargin) or 45
            if challenger and challengerDelta + margin < currentDelta then
                AimTarget = challenger
            end
        end
    elseif not AimTarget and not Settings.AIM.StickyLock then
        return
    end
    if not AimTarget then return end

    -- Check the currently locked player every frame with a lightweight test.
    -- This prevents the ~0.20s team-cache interval from keeping the camera
    -- attached to a dead/invisible placeholder after a kill.
    if isLikelyDeadOrGhost(AimTarget) then
        AimTarget = nil
        return
    end

    local targetChar = AimTarget.Character
    local targetPart = getTargetPart(AimTarget, Settings.AIM.TargetPart)
    if not targetChar or not targetChar.Parent or not targetPart or not targetPart:IsDescendantOf(targetChar) then
        AimTarget = nil
        return
    end

    -- Visible Check is continuous: it blocks camera movement through walls without dropping the sticky target.
    if Settings.AIM.VisibleCheck and not hasLineOfSight(targetPart, AimTarget) then
        return
    end

    if AimTarget == nil or isLikelyDeadOrGhost(AimTarget) then
        AimTarget = nil
        return
    end

    local aimPos = targetPart.Position
    if Settings.AIM.Prediction > 0 then
        local root = getRoot(AimTarget)
        if root then
            aimPos += root.AssemblyLinearVelocity * Settings.AIM.Prediction
        end
    end

    local current = Camera.CFrame
    local desired = CFrame.lookAt(current.Position, aimPos, Vector3.yAxis)
    local result = Settings.AIM.HardLock and desired or current:Lerp(desired, math.clamp(Settings.AIM.Smooth, 0.02, 1))

    pcall(function()
        Camera.CFrame = result
    end)
end

-- Run after Roblox's camera controller so the game's own camera update does not overwrite the aim.
pcall(function()
    RunService:BindToRenderStep("NEXUS_KNIFE_AIM", Enum.RenderPriority.Last.Value, function()
        if Alive then
            aimStep(1/60)
        end
    end)
end)



