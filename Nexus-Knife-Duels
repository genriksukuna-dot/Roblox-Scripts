local function debugValue(v)
    local tv = typeof(v)
    if tv == "Instance" then
        local ok, full = pcall(function() return v:GetFullName() end)
        return ok and full or tostring(v)
    elseif tv == "Color3" then
        return string.format("rgb(%d,%d,%d)", math.floor(v.R*255+0.5), math.floor(v.G*255+0.5), math.floor(v.B*255+0.5))
    elseif tv == "BrickColor" then
        return "BrickColor(" .. tostring(v.Name) .. ")"
    else
        return tostring(v)
    end
end

local function collectTeamDebug(plr)
    if not plr then return nil end
    local out = {attrs = {}, values = {}, markers = {}}
    pcall(function()
        out.name = plr.DisplayName .. " @" .. plr.Name
        out.userId = plr.UserId
        out.neutral = plr.Neutral
        out.team = plr.Team and plr.Team.Name or "None"
        out.teamColor = plr.TeamColor and plr.TeamColor.Name or "None"
    end)

    local function scan(container, prefix)
        if not container then return end
        pcall(function()
            for k, v in pairs(container:GetAttributes()) do
                local nk = normName(k)
                if TEAM_ATTRIBUTE_NAMES[nk] or nk:find("team",1,true) or nk:find("side",1,true) or nk:find("faction",1,true) or nk:find("duel",1,true) then
                    table.insert(out.attrs, prefix .. "." .. tostring(k) .. " = " .. debugValue(v))
                end
            end
        end)
        pcall(function()
            for _, obj in ipairs(container:GetChildren()) do
                local nn = normName(obj.Name)
                if TEAM_ATTRIBUTE_NAMES[nn] or nn:find("team",1,true) or nn:find("side",1,true) or nn:find("faction",1,true) or nn:find("duel",1,true) then
                    if obj:IsA("StringValue") or obj:IsA("IntValue") or obj:IsA("NumberValue") or obj:IsA("ObjectValue") or obj:IsA("BrickColorValue") or obj:IsA("Color3Value") or obj:IsA("BoolValue") then
                        local ok, value = pcall(function() return obj.Value end)
                        if ok then table.insert(out.values, prefix .. "." .. obj.Name .. " = " .. debugValue(value)) end
                    end
                end
            end
        end)
    end

    scan(plr, "Player")
    local char = plr.Character
    scan(char, "Character")

    if char then
        pcall(function()
            for _, obj in ipairs(char:GetDescendants()) do
                if obj:IsA("Highlight") then
                    table.insert(out.markers, string.format("Highlight %s Fill=%s Outline=%s", obj.Name, debugValue(obj.FillColor), debugValue(obj.OutlineColor)))
                elseif obj:IsA("SelectionBox") then
                    table.insert(out.markers, string.format("SelectionBox %s Color=%s", obj.Name, debugValue(obj.Color3)))
                elseif obj:IsA("BoxHandleAdornment") then
                    table.insert(out.markers, string.format("BoxAdornment %s Color=%s", obj.Name, debugValue(obj.Color3)))
                elseif obj:IsA("TextLabel") or obj:IsA("TextButton") then
                    local txt = tostring(obj.Text or "")
                    local lc = txt:lower()
                    if lc:find("team",1,true) or lc:find("enemy",1,true) or lc:find("ally",1,true) or lc:find("friend",1,true) or lc:find("duel",1,true) then
                        table.insert(out.markers, string.format("%s %s Text=%q Color=%s", obj.ClassName, obj.Name, txt, debugValue(obj.TextColor3)))
                    end
                end
                if #out.markers >= 18 then break end
            end
        end)
    end

    out.nativeKey = getNativeTeamKey(plr) or "nil"
    out.custom = getCustomTeamSignals(plr)
    out.relation = getTeamRelation(plr)
    return out
end

local function sortLines(t)
    table.sort(t, function(a,b) return tostring(a) < tostring(b) end)
end

local function updateTeamDebug()
    if not TeamDebugRefs.localInfo then return end
    startHudTeamRefresh(false)
    local localData = collectTeamDebug(LocalPlayer)
    local knownAllies, knownEnemies = 0, 0
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local rel = getTeamRelation(plr)
            if rel == "ally" then knownAllies += 1 end
            if rel == "enemy" then knownEnemies += 1 end
        end
    end
    local target = AimTarget
    if not target or not target.Parent then
        target = nil
        local bestScreen = math.huge
        local viewport = Camera and Camera.ViewportSize or Vector2.new(1920, 1080)
        local center = Vector2.new(viewport.X/2, viewport.Y/2)
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and validTarget(plr, false) then
                local part = getTargetPart(plr, Settings.AIM.TargetPart) or getRoot(plr)
                local root = getRoot(plr)
                if part and root and Camera then
                    local pos, onScreen, z = worldToScreen(part.Position)
                    local dist = (root.Position - Camera.CFrame.Position).Magnitude
                    if onScreen and z > 0 and dist <= 2500 then
                        local sd = (pos - center).Magnitude
                        if sd < bestScreen then
                            bestScreen = sd
                            target = plr
                        end
                    end
                end
            end
        end
    end
    local targetData = collectTeamDebug(target)

    if localData then
        TeamDebugRefs.localInfo.Text = string.format(
            "Name: %s\nUserId: %d\nPlayer.Team: %s\nPlayer.TeamColor: %s\nPlayer.Neutral: %s\nNative key: %s\nCustom signals: %s\nComputed self relation: %s",
            localData.name or LocalPlayer.Name, localData.userId or 0, tostring(localData.team), tostring(localData.teamColor),
            tostring(localData.neutral), tostring(localData.nativeKey), next(localData.custom) and "YES" or "none", tostring(localData.relation)
        )
    end

    if targetData then
        local relationColor = targetData.relation == "ally" and TEAM_GREEN or targetData.relation == "enemy" and ENEMY_RED or NEUTRAL_GREY
        TeamDebugRefs.status.Text = targetData.relation:upper() .. "  •  " .. tostring(targetData.name)
        TeamDebugRefs.status.TextColor3 = relationColor
        TeamDebugRefs.statusSub.Text = string.format(
            "Target from: %s • Known allies: %d • Known enemies: %d",
            (AimTarget == target and "Aimbot lock" or "nearby diagnostic fallback"), knownAllies, knownEnemies
        )
        TeamDebugRefs.targetInfo.Text = string.format(
            "Name: %s\nUserId: %d\nPlayer.Team: %s\nPlayer.TeamColor: %s\nPlayer.Neutral: %s\nNative key: %s\nComputed relation: %s\nAttributes found: %d\nValue objects found: %d",
            targetData.name or target.Name, targetData.userId or 0, tostring(targetData.team), tostring(targetData.teamColor), tostring(targetData.neutral),
            tostring(targetData.nativeKey), tostring(targetData.relation), #targetData.attrs, #targetData.values
        )

        local attrs = table.clone(targetData.attrs)
        local vals = table.clone(targetData.values)
        local marks = table.clone(targetData.markers)
        sortLines(attrs); sortLines(vals); sortLines(marks)
        local parts = {}
        if #attrs > 0 then table.insert(parts, "ATTRIBUTES:\n" .. table.concat(attrs, "\n")) end
        if #vals > 0 then table.insert(parts, "VALUES:\n" .. table.concat(vals, "\n")) end
        if next(targetData.custom) then
            local customLines = {}
            for k,v in pairs(targetData.custom) do table.insert(customLines, tostring(k) .. " = " .. tostring(v)) end
            sortLines(customLines)
            table.insert(parts, "RECOGNIZED CUSTOM:\n" .. table.concat(customLines, "\n"))
        end
        TeamDebugRefs.signalsInfo.Text = #parts > 0 and table.concat(parts, "\n\n") or "No explicit team attributes/value objects were found."
        TeamDebugRefs.markersInfo.Text = #marks > 0 and table.concat(marks, "\n") or "No explicit Highlight / SelectionBox / team-labelled UI markers found on the character."
    else
        TeamDebugRefs.status.Text = "NO TARGET"
        TeamDebugRefs.status.TextColor3 = NEUTRAL_GREY
        TeamDebugRefs.statusSub.Text = "Enable Aimbot or stand near a player to populate diagnostics."
        TeamDebugRefs.targetInfo.Text = "No target is currently selected.\n\nThe debug panel will not change Team Check behavior."
        TeamDebugRefs.signalsInfo.Text = "Waiting for a target…"
        TeamDebugRefs.markersInfo.Text = "Waiting for a target…"
    end
end

