local function makeESPLine(thickness)
    local f = Instance.new("Frame")
    f.AnchorPoint = Vector2.new(0.5, 0.5)
    f.BorderSizePixel = 0
    f.BackgroundColor3 = Settings.UI.Accent
    f.Size = UDim2.fromOffset(1, thickness)
    f.Visible = false
    f.Parent = ESPGui
    return f
end

local function clearEspOverlay()
    safeDestroy(ESPGui)
end

local function setScreenLine(obj, a, b, thickness, color)
    if not obj or not a or not b then return end
    local delta = b - a
    local length = delta.Magnitude
    if length < 0.5 then
        obj.Visible = false
        return
    end
    obj.AnchorPoint = Vector2.new(0.5, 0.5)
    obj.Position = UDim2.fromOffset((a.X+b.X)/2, (a.Y+b.Y)/2)
    obj.Size = UDim2.fromOffset(length, math.max(1, thickness or 1))
    obj.Rotation = math.deg(math.atan2(delta.Y, delta.X))
    obj.BackgroundColor3 = color or Settings.UI.Accent
    obj.Visible = true
end

local function addEspEntry(plr)
    if espEntries[plr] then return espEntries[plr] end
    local e = {
        player = plr,
        bones = {},
        name = makeESPText(13),
        health = makeESPText(11),
        line = makeESPLine(1),
    }
    local bonePairs = {
        {"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"},
        {"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"},
        {"LeftLowerArm", "LeftHand"}, {"UpperTorso", "RightUpperArm"},
        {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"},
        {"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"},
        {"LeftLowerLeg", "LeftFoot"}, {"LowerTorso", "RightUpperLeg"},
        {"RightUpperLeg", "RightLowerLeg"}, {"RightLowerLeg", "RightFoot"},
        {"UpperTorso", "Left Arm"}, {"UpperTorso", "Right Arm"},
        {"LowerTorso", "Left Leg"}, {"LowerTorso", "Right Leg"},
        {"Torso", "Left Arm"}, {"Torso", "Right Arm"},
        {"Torso", "Left Leg"}, {"Torso", "Right Leg"},
    }
    for _, pair in ipairs(bonePairs) do
        table.insert(e.bones, {
            drawing = makeESPLine(1),
            a = pair[1],
            b = pair[2],
        })
    end
    espEntries[plr] = e
    return e
end

local function hideEsp(e)
    if not e then return end
    if e.name then e.name.Visible = false end
    if e.health then e.health.Visible = false end
    if e.line then e.line.Visible = false end
    for _, bone in ipairs(e.bones) do
        if bone.drawing then bone.drawing.Visible = false end
    end
end

local function destroyEspEntry(plr)
    local e = espEntries[plr]
    if not e then return end
    local items = {e.name, e.health, e.line}
    for _, x in ipairs(items) do safeDestroy(x) end
    for _, bone in ipairs(e.bones) do safeDestroy(bone.drawing) end
    espEntries[plr] = nil
end

