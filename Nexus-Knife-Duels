local function addSlider(parent, title, minv, maxv, getValue, setValue, decimals)
    local r = addRow(parent, 62)
    local t = makeText(r, title, 12, Color3.fromRGB(235,238,244), true)
    t.Position = UDim2.new(0,14,0,8)
    t.Size = UDim2.new(0.52,0,0,20)
    local valueLabel = makeText(r, "", 11, Settings.UI.Accent, true)
    valueLabel.Position = UDim2.new(0.56,0,0,8)
    valueLabel.Size = UDim2.new(0.4,-14,0,20)
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1,-28,0,6)
    bar.Position = UDim2.new(0,14,1,-17)
    bar.BackgroundColor3 = Color3.fromRGB(34,35,44)
    bar.Parent = r
    corner(bar,5)
    local fill = Instance.new("Frame")
    fill.BackgroundColor3 = Settings.UI.Accent
    fill.BorderSizePixel = 0
    fill.Parent = bar
    corner(fill,5)

    local dragging = false
    local function formatValue(v)
        if decimals == 0 then return string.format("%d", math.floor(v + 0.5)) end
        return string.format("%."..decimals.."f", v)
    end
    local function refresh()
        local val = getValue()
        local alpha = math.clamp((val-minv)/(maxv-minv),0,1)
        fill.Size = UDim2.new(alpha,0,1,0)
        valueLabel.Text = formatValue(val)
    end
    local function setFromX(x)
        local alpha = math.clamp((x - bar.AbsolutePosition.X)/bar.AbsoluteSize.X,0,1)
        local val = minv + (maxv-minv)*alpha
        setValue(val)
        refresh()
    end
    connect(bar.InputBegan, function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            setFromX(inp.Position.X)
        end
    end)
    connect(UserInputService.InputChanged, function(inp)
        if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
            setFromX(inp.Position.X)
        end
    end)
    connect(UserInputService.InputEnded, function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
    refresh()
    return r
end

