-- ============================================================
-- CUSTOM HEALTH ADAPTER
-- Some Knife Duels builds do not use Humanoid.Health for the real
-- combat HP. Resolve replicated attributes/values first and only
-- fall back to Humanoid when no custom value is exposed.
-- ============================================================
local function normName(v)
    return tostring(v or ""):lower():gsub('[%s_%-%."]', "")
end

local CURRENT_HP_NAMES = {
    health = true, hp = true, currenthealth = true, currenthp = true,
    playerhealth = true, playerhp = true, healthvalue = true, hpvalue = true,
    realhealth = true, realhp = true, serverhealth = true,
}

local MAX_HP_NAMES = {
    maxhealth = true, maxhp = true, maxhealthvalue = true,
    maximumhealth = true, maximumhp = true, healthmax = true, hpmax = true,
}

local DEATH_NAMES = {
    dead = true, died = true, eliminated = true, isdead = true,
    deadstate = true, eliminatedstate = true, alive = false,
}

local function numericValue(x)
    if typeof(x) == "number" then return x end
    if typeof(x) == "string" then
        local n = tonumber(x)
        if n then return n end
    end
    return nil
end

local function readHealthObject(obj, current, maximum, deathFlag)
    local cls = obj.ClassName
    if cls == "IntValue" or cls == "NumberValue" or cls == "DoubleConstrainedValue" then
        local n = numericValue(obj.Value)
        if n then
            local nn = normName(obj.Name)
            if CURRENT_HP_NAMES[nn] and current == nil then current = n end
            if MAX_HP_NAMES[nn] and maximum == nil then maximum = n end
        end
    end
    local nn = normName(obj.Name)
    if (cls == "BoolValue") then
        local ok, v = pcall(function() return obj.Value end)
        if ok then
            if DEATH_NAMES[nn] == true and v == true then deathFlag = true end
            if nn == "alive" and v == false then deathFlag = true end
        end
    elseif cls == "StringValue" then
        local ok, v = pcall(function() return obj.Value end)
        if ok and type(v) == "string" then
            local a, b = v:match("([%d%.]+)%s*/%s*([%d%.]+)")
            if a and CURRENT_HP_NAMES[nn] and current == nil then current = tonumber(a) end
            if b and CURRENT_HP_NAMES[nn] and maximum == nil then maximum = tonumber(b) end
            if v:lower():find("dead", 1, true) or v:lower():find("eliminated", 1, true) then
                deathFlag = true
            end
        end
    end
    return current, maximum, deathFlag
end

local function readHealthContainer(container)
    if not container then return nil, nil, false, false end
    local current, maximum, dead = nil, nil, false
    local foundCustom = false

    -- Attributes are the cheapest and most reliable path for games that
    -- replicate combat state outside the Humanoid.
    pcall(function()
        for k, v in pairs(container:GetAttributes()) do
            local nk = normName(k)
            local n = numericValue(v)
            if n then
                if CURRENT_HP_NAMES[nk] and current == nil then current = n; foundCustom = true end
                if MAX_HP_NAMES[nk] and maximum == nil then maximum = n; foundCustom = true end
            elseif DEATH_NAMES[nk] == true and v == true then
                dead = true
            elseif nk == "alive" and v == false then
                dead = true
            end
        end
    end)

    for _, obj in ipairs(container:GetDescendants()) do
        if obj ~= container then
            local beforeC, beforeM = current, maximum
            current, maximum, dead = readHealthObject(obj, current, maximum, dead)
            if current ~= beforeC or maximum ~= beforeM then foundCustom = true end
        end
    end

    return current, maximum, dead, foundCustom
end

local function parseHealthText(text)
    if type(text) ~= "string" then return nil, nil end
    local a, b = text:match("([%d%.]+)%s*/%s*([%d%.]+)")
    if a then return tonumber(a), tonumber(b) end
    local n = text:match("([%d%.]+)%s*%%")
    if n then
        return nil, tonumber(n)
    end
    return nil, nil
end

local function getCustomHealthState(plr)
    local char = getCharacter(plr)
    local hum = getHumanoid(char)
    if not char then return nil, nil, false, false end

    local containers = {char, plr, hum, getRoot(plr)}
    local current, maximum, dead, foundCustom = nil, nil, false, false
    for _, container in ipairs(containers) do
        if container then
            local c, m, d, found = readHealthContainer(container)
            if current == nil and c ~= nil then current = c end
            if maximum == nil and m ~= nil then maximum = m end
            dead = dead or d
            foundCustom = foundCustom or found
        end
    end

    -- Some versions expose the real HP only as replicated BillboardGui text.
    if current == nil or maximum == nil then
        for _, obj in ipairs(char:GetDescendants()) do
            if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                local c, m = parseHealthText(obj.Text)
                if c ~= nil then current = current or c; maximum = maximum or m; foundCustom = true end
            end
        end
    end

    if current ~= nil then
        if maximum == nil or maximum <= 0 then maximum = math.max(current, 100) end
        if current <= 0 then dead = true end
        return current, maximum, dead, foundCustom
    end

    if hum then
        local h = numericValue(hum.Health)
        local mh = numericValue(hum.MaxHealth)
        if h ~= nil and mh ~= nil then
            return h, mh, dead, false
        end
    end
    return nil, nil, dead, foundCustom
end

local function isAlive(plr)
    local char = getCharacter(plr)
    local hum = getHumanoid(char)
    if not char or not hum or hum.Parent ~= char then return false end

    local hp, maxHp, customDead = getCustomHealthState(plr)
    if customDead then return false end
    if hp ~= nil and maxHp ~= nil then
        if hp <= 0 or maxHp <= 0 then return false end
    elseif hum.Health <= 0 or hum.MaxHealth <= 0 then
        return false
    end

    if char:GetAttribute("Dead") == true or char:GetAttribute("Died") == true or char:GetAttribute("Eliminated") == true then return false end
    if plr:GetAttribute("Dead") == true or plr:GetAttribute("Eliminated") == true then return false end
    local state = hum:GetState()
    if state == Enum.HumanoidStateType.Dead then return false end
    local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    if not root then return false end
    return true
end

local function getPart(char, name)
    if not char then return nil end
    return char:FindFirstChild(name)
        or char:FindFirstChild(name:gsub("Upper", ""))
        or char:FindFirstChild(name .. "Part")
end

-- ============================================================
-- TEAM IDENTITY ADAPTER
-- Knife Duels does not consistently populate Player.Team.  The live HUD
-- scoreboard is therefore treated as the game-specific source when it can
-- be mapped to a player.  Everything is cached so this does not scan the
-- entire PlayerGui/character tree every frame.
-- ============================================================
local NEUTRAL_TEAM_COLORS = {
    ["Medium stone grey"] = true,
    ["Institutional white"] = true,
    ["White"] = true,
}

local TEAM_ATTRIBUTE_NAMES = {
    team = true, teamid = true, teamname = true,
    duelteam = true, duelside = true, duelsquad = true,
    matchteam = true, matchside = true, matchid = true,
    squad = true, squadid = true, squadname = true,
    faction = true, factionid = true, factionname = true,
    side = true, sideid = true,
    teamcolor = true,
    isteammate = true, teammate = true, ally = true, friendly = true,
    isenemy = true, enemy = true, hostile = true,
}

local TEAM_GREEN = Color3.fromRGB(80, 255, 130)
local ENEMY_RED = Color3.fromRGB(255, 75, 75)
local NEUTRAL_GREY = Color3.fromRGB(170, 170, 170)

local TEAM_BOOL_NAMES = {
    teammate = "ally", isteammate = "ally", ally = "ally", friendly = "ally", friend = "ally",
    enemy = "enemy", isenemy = "enemy", hostile = "enemy",
}

local function normalizedTeamValue(v)
    if typeof(v) == "Instance" then
        local ok, name = pcall(function() return v:GetFullName() end)
        return ok and ("instance:" .. tostring(name):lower()) or nil
    elseif typeof(v) == "BrickColor" then
        return "brick:" .. tostring(v.Name):lower()
    elseif typeof(v) == "Color3" then
        return string.format("color:%d:%d:%d", math.floor(v.R*255+0.5), math.floor(v.G*255+0.5), math.floor(v.B*255+0.5))
    elseif typeof(v) == "string" or typeof(v) == "number" then
        local x = tostring(v):lower():gsub("%s+", "")
        return x ~= "" and ("value:" .. x) or nil
    end
    return nil
end

local function getNativeTeamKey(plr)
    if not plr then return nil end
    local okT, team = pcall(function() return plr.Team end)
    if okT and team then
        local okN, n = pcall(function() return team.Name end)
        if okN and n and n ~= "" and not tostring(n):lower():find("neutral", 1, true) then
            return "team:" .. tostring(n):lower()
        end
    end
    local okC, teamColor = pcall(function() return plr.TeamColor end)
    if okC and teamColor then
        local name = tostring(teamColor.Name)
        if not NEUTRAL_TEAM_COLORS[name] then
            return "color:" .. name:lower()
        end
    end
    return nil
end

-- Lightweight custom-signal scan.  We intentionally do NOT call
-- GetDescendants() on every player in the render loop: that was the source
-- of the severe mobile frame drops seen in Team Debug.
local function getCustomTeamSignals(plr)
    local out = {}
    if not plr then return out end
    local function put(name, value)
        local nn = normName(name)
        if not nn then return end
        if TEAM_ATTRIBUTE_NAMES[nn] or TEAM_BOOL_NAMES[nn] then
            if typeof(value) == "boolean" and TEAM_BOOL_NAMES[nn] then
                out[nn] = value and "bool:true" or "bool:false"
            else
                local key = normalizedTeamValue(value)
                if key then out[nn] = key end
            end
        end
    end
    local function scan(container, directOnly)
        if not container then return end
        pcall(function()
            for name, value in pairs(container:GetAttributes()) do
                put(name, value)
            end
        end)
        pcall(function()
            for _, obj in ipairs(container:GetChildren()) do
                if TEAM_ATTRIBUTE_NAMES[normName(obj.Name)] or TEAM_BOOL_NAMES[normName(obj.Name)] then
                    if obj:IsA("StringValue") or obj:IsA("IntValue") or obj:IsA("NumberValue")
                        or obj:IsA("ObjectValue") or obj:IsA("BrickColorValue") or obj:IsA("Color3Value")
                        or obj:IsA("BoolValue") then
                        local ok, value = pcall(function() return obj.Value end)
                        if ok then put(obj.Name, value) end
                    end
                end
            end
        end)
    end
    scan(plr, true)
    scan(plr.Character, true)
    return out
end

-- ============================================================
-- KNIFE DUELS ROUND-SIDE RESOLVER
--
-- Knife Duels does not reliably replicate Player.Team.  In this place the
-- actual round side is represented by the two groups of player cards in the
-- top scoreboard.  The important part is NOT the green/red color itself:
-- colors can change with score/state.  We first map each visible card back
-- to a Player, then split the cards into the two X-axis groups.  The local
-- player's group is the ally side; the other group is the enemy side.
--
-- The scan is asynchronous and throttled so Team Check never blocks the
-- render loop on mobile.
-- ============================================================
local HudTeamCache = {
    stamp = 0,
    byPlayer = {},
    localGroup = nil,
    refreshing = false,
    thumbnails = {},
}
local HUD_SCAN_INTERVAL = 0.50

local function warmThumbnail(plr)
    if not plr or HudTeamCache.thumbnails[plr] then return end
    HudTeamCache.thumbnails[plr] = false
    task.spawn(function()
        local cache = {}
        local types = {Enum.ThumbnailType.HeadShot, Enum.ThumbnailType.AvatarBust}
        for _, thumbType in ipairs(types) do
            local ok, url = pcall(function()
                return Players:GetUserThumbnailAsync(plr.UserId, thumbType, Enum.ThumbnailSize.Size48x48)
            end)
            if ok and url then
                cache[tostring(url)] = true
            end
        end
        HudTeamCache.thumbnails[plr] = cache
    end)
end

for _, plr in ipairs(Players:GetPlayers()) do
    warmThumbnail(plr)
end
Players.PlayerAdded:Connect(warmThumbnail)
Players.PlayerRemoving:Connect(function(plr)
    HudTeamCache.thumbnails[plr] = nil
    HudTeamCache.byPlayer[plr] = nil
    HudTeamCache.stamp = 0
end)

local function parseThumbnailUserId(image)
    local img = tostring(image or "")
    if img == "" then return nil end
    -- Roblox thumbnail URLs normally carry the user id directly.
    local id = img:match("[?&]id=(%d+)")
        or img:match("[/=](%d+)[/?&#]?$")
        or img:match("Avatar[%w_%-]*[?&].-id=(%d+)")
    return id and tonumber(id) or nil
end

local function imageMatchesPlayer(image, plr)
    if not image or not plr then return false end
    local img = tostring(image)
    if img == "" then return false end
    local directId = parseThumbnailUserId(img)
    if directId and directId == plr.UserId then return true end
    local cache = HudTeamCache.thumbnails[plr]
    if cache and cache[img] then return true end
    local low = img:lower()
    local uid = tostring(plr.UserId)
    if low:find("id=" .. uid, 1, true)
        or low:find("userid=" .. uid, 1, true)
        or low:find("user_id=" .. uid, 1, true) then
        return true
    end
    -- Some executors normalize thumbnail URLs and strip separators.
    if #uid >= 5 and low:find(uid, 1, true) and not low:find("rbxasset", 1, true) then
        return true
    end
    return false
end

local function textMatchesPlayer(text, plr)
    if not text or not plr then return false end
    local v = tostring(text):lower()
    local a = tostring(plr.Name):lower()
    local b = tostring(plr.DisplayName):lower()
    if v == a or v == b then return true end
    if #a >= 4 and v:find(a, 1, true) then return true end
    if #b >= 4 and v:find(b, 1, true) then return true end
    return false
end

local function getCandidateSideColor(obj)
    -- Only inspect the card itself / immediate visual children. Do not walk
    -- up into the whole scoreboard, because that mixes both team colors.
    local best, bestScore
    local function consider(c, score)
        if typeof(c) ~= "Color3" then return end
        local r,g,b = c.R,c.G,c.B
        local maxv = math.max(r,g,b)
        local minv = math.min(r,g,b)
        local sat = maxv > 0 and ((maxv-minv)/maxv) or 0
        if maxv < 0.35 or sat < 0.28 then return end
        local side, s
        if g > r*1.18 and g > b*1.03 then side,s="green",score
        elseif r > g*1.18 and r > b*1.08 then side,s="red",score
        end
        if side and (not bestScore or s > bestScore) then
            best, bestScore = side, s
        end
    end
    pcall(function()
        if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
            consider(obj.ImageColor3, 0.5)
        end
        local parent = obj.Parent
        for _ = 1, 2 do
            if not parent then break end
            for _, child in ipairs(parent:GetChildren()) do
                if child:IsA("UIStroke") then
                    consider(child.Color, 3)
                elseif child:IsA("Frame") then
                    consider(child.BackgroundColor3, 0.5)
                end
            end
            parent = parent.Parent
        end
    end)
    return best
end

local function startHudTeamRefresh(force)
    local now = os.clock()
    if HudTeamCache.refreshing then return end
    if not force and now - HudTeamCache.stamp < HUD_SCAN_INTERVAL then return end

    local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not playerGui then return end

    HudTeamCache.refreshing = true
    task.spawn(function()
        local raw = {}
        local players = Players:GetPlayers()
        local function remember(plr, x, y, color, score)
            if not plr then return end
            local old = raw[plr]
            if not old or (score or 0) > (old.score or 0) then
                raw[plr] = {x=x, y=y, color=color, score=score or 0}
            end
        end

        local ok = pcall(function()
            local scanned = 0
            for _, obj in ipairs(playerGui:GetDescendants()) do
                scanned += 1
                if scanned % 120 == 0 then task.wait() end
                if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
                    local y = obj.AbsolutePosition.Y
                    local h = obj.AbsoluteSize.Y
                    local w = obj.AbsoluteSize.X
                    if y >= -40 and y <= 360 and h >= 14 and w >= 14 and w <= 220 then
                        local image = obj.Image
                        if image and image ~= "" then
                            local color = getCandidateSideColor(obj)
                            local uid = parseThumbnailUserId(image)
                            local mapped
                            if uid then
                                for _, plr in ipairs(players) do
                                    if plr.UserId == uid then mapped = plr break end
                                end
                            end
                            if mapped then
                                remember(mapped, obj.AbsolutePosition.X + w*0.5, y, color, 3)
                            else
                                for _, plr in ipairs(players) do
                                    if imageMatchesPlayer(image, plr) then
                                        remember(plr, obj.AbsolutePosition.X + w*0.5, y, color, color and 2 or 1)
                                    end
                                end
                            end
                        end
                    end
                elseif obj:IsA("TextLabel") or obj:IsA("TextButton") then
                    local y = obj.AbsolutePosition.Y
                    local h = obj.AbsoluteSize.Y
                    if y >= -40 and y <= 360 and h >= 8 and h <= 96 then
                        local text = obj.Text
                        if text and text ~= "" then
                            for _, plr in ipairs(players) do
                                if textMatchesPlayer(text, plr) then
                                    remember(plr, obj.AbsolutePosition.X + obj.AbsoluteSize.X*0.5, y, getCandidateSideColor(obj), 0.75)
                                end
                            end
                        end
                    end
                end
            end
        end)

        if ok then
            local points = {}
            for plr, data in pairs(raw) do
                table.insert(points, {plr=plr, x=data.x, color=data.color})
            end
            table.sort(points, function(a,b) return a.x < b.x end)

            -- Build exactly two positional groups. Prefer the largest natural
            -- gap, but fall back to a small 1D two-cluster pass when the UI
            -- compresses the cards so the largest-gap heuristic is ambiguous.
            local groups = {}
            if #points >= 2 then
                local split, bestGap = nil, -math.huge
                for i = 1, #points-1 do
                    local gap = points[i+1].x - points[i].x
                    if gap > bestGap then
                        bestGap, split = gap, i
                    end
                end

                local shouldSplit = split ~= nil
                if #points >= 3 then
                    local gaps = {}
                    for i=1,#points-1 do gaps[#gaps+1] = points[i+1].x-points[i].x end
                    table.sort(gaps)
                    local median = gaps[math.ceil(#gaps/2)] or 0
                    shouldSplit = bestGap >= math.max(28, median * 1.8)
                end

                if shouldSplit then
                    for i, pt in ipairs(points) do
                        groups[pt.plr] = (i <= split) and 1 or 2
                    end
                else
                    -- Two-means on X. The scoreboard is already sorted and
                    -- contains only the top-row player cards, so this is cheap.
                    local c1, c2 = points[1].x, points[#points].x
                    for _ = 1, 4 do
                        local sum1, n1, sum2, n2 = 0,0,0,0
                        for _, pt in ipairs(points) do
                            if math.abs(pt.x-c1) <= math.abs(pt.x-c2) then
                                sum1 += pt.x; n1 += 1
                            else
                                sum2 += pt.x; n2 += 1
                            end
                        end
                        if n1 > 0 then c1 = sum1/n1 end
                        if n2 > 0 then c2 = sum2/n2 end
                    end
                    for _, pt in ipairs(points) do
                        groups[pt.plr] = math.abs(pt.x-c1) <= math.abs(pt.x-c2) and 1 or 2
                    end
                end
            end

            local localGroup = groups[LocalPlayer]
            local localColor = raw[LocalPlayer] and raw[LocalPlayer].color or nil
            local byPlayer = {}

            -- IMPORTANT FOR KNIFE DUELS: team sides can be reassigned between
            -- rounds while Player.Team stays Neutral/None.  Never interpret
            -- green/red as an absolute "friendly/enemy" meaning.  Instead,
            -- compare each card to THIS ROUND'S local-player card.
            if localColor == "green" or localColor == "red" then
                for plr, data in pairs(raw) do
                    if plr ~= LocalPlayer and (data.color == "green" or data.color == "red") then
                        byPlayer[plr] = (data.color == localColor) and "ally" or "enemy"
                    end
                end
            end

            -- Positional grouping remains the fallback for cards without a
            -- usable color marker (some UI states briefly hide the stroke).
            if localGroup then
                for plr, group in pairs(groups) do
                    if plr ~= LocalPlayer and byPlayer[plr] == nil then
                        byPlayer[plr] = (group == localGroup) and "ally" or "enemy"
                    end
                end
            end

            -- Final color fallback is still RELATIVE to the local card.
            -- This is intentionally not green=ally/red=enemy, because Knife
            -- Duels can swap the represented side between rounds.
            if localColor == "green" or localColor == "red" then
                for plr, data in pairs(raw) do
                    if plr ~= LocalPlayer and byPlayer[plr] == nil and (data.color == "green" or data.color == "red") then
                        byPlayer[plr] = (data.color == localColor) and "ally" or "enemy"
                    end
                end
            end

            -- Publish atomically. During score-board animation/rebuild the
            -- scan can temporarily see zero/one card. Do NOT destroy a good
            -- round map in that transient state: doing so makes ESP/Aimbot
            -- flicker or disappear after the first round. A new round is
            -- explicitly cleared only by LocalPlayer respawn below.
            local enemyCount = 0
            for plr, rel in pairs(byPlayer) do
                if plr ~= LocalPlayer and (rel == "ally" or rel == "enemy") then
                    enemyCount += 1
                end
            end
            local confident = (localGroup ~= nil or localColor == "green" or localColor == "red")
                and enemyCount >= 1

            if confident then
                HudTeamCache.byPlayer = byPlayer
                HudTeamCache.localGroup = localGroup
            end
            HudTeamCache.stamp = os.clock()
        end
        HudTeamCache.refreshing = false
    end)
end

-- ============================================================
-- CHARACTER NAMEPLATE TEAM RESOLVER
--
-- Knife Duels also paints the floating player nameplate with the round
-- side color.  This is useful for players whose scoreboard avatar cannot be
-- mapped back to a Player instance.  The cache is refreshed off the render
-- loop, so all enemies can be classified without repeatedly walking their
-- character trees during target acquisition.
-- ============================================================
local VisualTeamCache = {
    stamp = 0,
    byPlayer = {},
    localSide = nil,
    refreshing = false,
}
local VISUAL_TEAM_SCAN_INTERVAL = 0.50

local function classifyTeamColor(color)
    if typeof(color) ~= "Color3" then return nil end
    local r,g,b = color.R,color.G,color.B
    local maxv = math.max(r,g,b)
    local minv = math.min(r,g,b)
    local sat = maxv > 0 and ((maxv-minv)/maxv) or 0
    if maxv < 0.30 or sat < 0.25 then return nil end
    if r > g*1.14 and r > b*1.06 then return "red" end
    if g > r*1.12 and g > b*1.02 then return "green" end
    return nil
end

local function refreshVisualTeamCache(force)
    local now = os.clock()
    if VisualTeamCache.refreshing then return end
    if not force and now - VisualTeamCache.stamp < VISUAL_TEAM_SCAN_INTERVAL then return end
    VisualTeamCache.refreshing = true

    task.spawn(function()
        local byPlayer, localSide = {}, nil
        for _, plr in ipairs(Players:GetPlayers()) do
            local char = plr.Character
            if char and char.Parent then
                local bestSide, bestScore, scanned = nil, 0, 0
                pcall(function()
                    -- First inspect the head/nameplate, where Knife Duels puts
                    -- the most useful red/green signal.
                    local head = char:FindFirstChild("Head")
                    if head then
                        for _, obj in ipairs(head:GetDescendants()) do
                            scanned += 1
                            if scanned % 100 == 0 then task.wait() end
                            local side, score
                            if obj:IsA("TextLabel") or obj:IsA("TextButton") then
                                side, score = classifyTeamColor(obj.TextColor3), 6
                            elseif obj:IsA("UIStroke") then
                                side, score = classifyTeamColor(obj.Color), 5
                            elseif obj:IsA("Frame") then
                                local n = obj.Name:lower()
                                if n:find("name",1,true) or n:find("tag",1,true) or n:find("health",1,true) or n:find("team",1,true) then
                                    side, score = classifyTeamColor(obj.BackgroundColor3), 3
                                end
                            end
                            if side and score > bestScore then bestSide, bestScore = side, score end
                        end
                    end
                    -- Extra fallback: some round UIs parent the name/HP widget
                    -- one or more levels above Head rather than under it. Walk a
                    -- few ancestors and inspect only their immediate children.
                    if not bestSide then
                        local anc = head
                        for _ = 1, 4 do
                            anc = anc and anc.Parent
                            if not anc then break end
                            for _, obj in ipairs(anc:GetChildren()) do
                                local side, score
                                if obj:IsA("TextLabel") or obj:IsA("TextButton") then
                                    side, score = classifyTeamColor(obj.TextColor3), 5
                                elseif obj:IsA("UIStroke") then
                                    side, score = classifyTeamColor(obj.Color), 5
                                elseif obj:IsA("Frame") then
                                    local n = obj.Name:lower()
                                    if n:find("name",1,true) or n:find("tag",1,true) or n:find("health",1,true) or n:find("team",1,true) then
                                        side, score = classifyTeamColor(obj.BackgroundColor3), 4
                                    end
                                end
                                if side and score > bestScore then bestSide, bestScore = side, score end
                            end
                        end
                    end
                    -- Fallback to the remaining character descendants.
                    if not bestSide then
                        for _, obj in ipairs(char:GetDescendants()) do
                            scanned += 1
                            if scanned % 140 == 0 then task.wait() end
                            local side, score
                            if obj:IsA("TextLabel") or obj:IsA("TextButton") then
                                side, score = classifyTeamColor(obj.TextColor3), 4
                            elseif obj:IsA("UIStroke") then
                                side, score = classifyTeamColor(obj.Color), 3
                            elseif obj:IsA("Frame") then
                                local n = obj.Name:lower()
                                if n:find("name",1,true) or n:find("tag",1,true) or n:find("health",1,true) or n:find("team",1,true) then
                                    side, score = classifyTeamColor(obj.BackgroundColor3), 2
                                end
                            end
                            if side and score > bestScore then bestSide, bestScore = side, score end
                        end
                    end
                end)
                if bestSide then
                    byPlayer[plr] = bestSide
                    if plr == LocalPlayer then localSide = bestSide end
                end
            end
        end
        local visualCount = 0
        for plr, side in pairs(byPlayer) do
            if plr ~= LocalPlayer and (side == "green" or side == "red") then
                visualCount += 1
            end
        end
        if localSide and visualCount >= 1 then
            VisualTeamCache.byPlayer = byPlayer
            VisualTeamCache.localSide = localSide
        end
        VisualTeamCache.stamp = os.clock()
        VisualTeamCache.refreshing = false
    end)
end

local TeamCache = {stamp = 0, native = {}, localNative = nil, custom = {}, localCustom = {}}
local TEAM_CACHE_INTERVAL = 0.75
local refreshTeamCache

local function invalidateTeamResolvers()
    -- A new round can reuse the same Player objects while swapping the actual
    -- side represented by the HUD. Drop every derived relation immediately so
    -- no previous-round ally/enemy decision survives the scoreboard rebuild.
    HudTeamCache.stamp = 0
    HudTeamCache.byPlayer = {}
    HudTeamCache.localGroup = nil
    VisualTeamCache.stamp = 0
    VisualTeamCache.byPlayer = {}
    VisualTeamCache.localSide = nil
    TeamCache.stamp = 0
end

-- IMPORTANT: a teammate/enemy dying must NOT wipe the entire round-side map.
-- Knife Duels keeps the same Player objects while characters are replaced.
-- Only LocalPlayer respawn is treated as a hard round-state reset.
local function bindCharacterHooks(p, isLocal)
    p.CharacterAdded:Connect(function()
        if not isLocal then
            -- Keep existing team relations for the rest of the round.
            -- Refresh this player's visual/team evidence without clearing the map.
            task.delay(0.25, function()
                startHudTeamRefresh(true)
                refreshVisualTeamCache(true)
                refreshTeamCache(true)
            end)
            return
        end

        -- Local respawn is the reliable hard boundary for a new round/state.
        invalidateTeamResolvers()
        task.delay(0.15, invalidateTeamResolvers)
        task.delay(0.60, function()
            invalidateTeamResolvers()
            startHudTeamRefresh(true)
            refreshVisualTeamCache(true)
            refreshTeamCache(true)
        end)
    end)

    p.CharacterRemoving:Connect(function()
        if isLocal then
            -- Do not clear enemy/ally data until the local player is actually
            -- spawning into the next state. This avoids ESP disappearing when
            -- somebody else is eliminated.
            return
        end
        -- Non-local death: keep the round-side identity. The same Player
        -- object is reused after respawn, and deleting its relation here was
        -- the reason Team Check/ESP collapsed mid-round.
        return
    end)
end

for _, p in ipairs(Players:GetPlayers()) do
    bindCharacterHooks(p, p == LocalPlayer)
end
Players.PlayerAdded:Connect(function(p)
    warmThumbnail(p)
    bindCharacterHooks(p, p == LocalPlayer)
end)

task.delay(0.50, function() startHudTeamRefresh(true) end)
task.delay(0.70, function() refreshVisualTeamCache(true) end)


refreshTeamCache = function(force)
    local now = os.clock()
    if not force and now - TeamCache.stamp < TEAM_CACHE_INTERVAL then return end
    local native, custom = {}, {}
    for _, plr in ipairs(Players:GetPlayers()) do
        native[plr] = getNativeTeamKey(plr)
        custom[plr] = getCustomTeamSignals(plr)
    end
    TeamCache.stamp = now
    TeamCache.native = native
    TeamCache.localNative = native[LocalPlayer]
    TeamCache.custom = custom
    TeamCache.localCustom = custom[LocalPlayer] or {}
end

local function boolSignal(signals, names)
    for _, n in ipairs(names) do
        local v = signals[n]
        if v == "bool:true" then return true end
        if v == "bool:false" then return false end
    end
    return nil
end

local function normalizeTeamName(value)
    local name
    pcall(function()
        if typeof(value) == "Instance" then
            name = value.Name
        elseif typeof(value) == "BrickColor" then
            name = value.Name
        else
            name = tostring(value)
        end
    end)
    return tostring(name or ""):lower():gsub("[%s%p_]+", "")
end

local NEUTRAL_TEAM_NAMES = {
    neutral = true,
    none = true,
    default = true,
    spectator = true,
    spectators = true,
    lobby = true,
    waiting = true,
    wait = true,
    unassigned = true,
    players = true,
    player = true,
}

local function isNeutralTeamObject(team)
    if not team then return true end
    local neutralAttr
    pcall(function()
        neutralAttr = team:GetAttribute("Neutral")
    end)
    if neutralAttr == true then return true end
    return NEUTRAL_TEAM_NAMES[normalizeTeamName(team)] == true
end

local function getReliableNativeRelation(plr)
    if not plr or plr == LocalPlayer then return "ally" end

    local localTeam, targetTeam
    pcall(function() localTeam = LocalPlayer.Team end)
    pcall(function() targetTeam = plr.Team end)

    -- Only trust Roblox Team when BOTH sides are real round teams.
    -- Knife Duels can expose a shared placeholder/neutral Team object.
    if localTeam and targetTeam
        and not isNeutralTeamObject(localTeam)
        and not isNeutralTeamObject(targetTeam) then
        return localTeam == targetTeam and "ally" or "enemy"
    end

    local lc, tc
    pcall(function() lc = LocalPlayer.TeamColor end)
    pcall(function() tc = plr.TeamColor end)
    if lc and tc then
        local ln = normalizeTeamName(lc)
        local tn = normalizeTeamName(tc)
        if ln ~= "" and tn ~= "" and not NEUTRAL_TEAM_NAMES[ln] and not NEUTRAL_TEAM_NAMES[tn]
            and not NEUTRAL_TEAM_COLORS[tostring(lc.Name)] and not NEUTRAL_TEAM_COLORS[tostring(tc.Name)] then
            return tostring(lc.Name) == tostring(tc.Name) and "ally" or "enemy"
        end
    end

    return nil
end

local function getTeamRelation(plr)
    if not plr then return "unknown" end
    if plr == LocalPlayer then return "ally" end

    -- 1) Knife Duels round scoreboard. This is the strongest source because
    -- it reflects the actual round side even when Roblox Team is neutral.
    startHudTeamRefresh(false)
    local hudRelation = HudTeamCache.byPlayer[plr]
    if hudRelation == "ally" or hudRelation == "enemy" then
        return hudRelation
    end

    -- 2) Overhead/nameplate side marker. Compare against the local player's
    -- CURRENT marker; never hardcode green/red as an absolute team.
    refreshVisualTeamCache(false)
    local targetVisual = VisualTeamCache.byPlayer[plr]
    local localVisual = VisualTeamCache.localSide
    if targetVisual and localVisual then
        return targetVisual == localVisual and "ally" or "enemy"
    end

    -- 3) Explicit replicated enemy/friendly signals.
    refreshTeamCache(false)
    local selfCustom = TeamCache.localCustom or {}
    local targetCustom = TeamCache.custom[plr] or {}
    local targetEnemy = boolSignal(targetCustom, {"enemy", "isenemy", "hostile", "opponent"})
    local targetAlly = boolSignal(targetCustom, {"teammate", "isteammate", "ally", "friendly", "friend"})

    if targetEnemy == true and targetAlly ~= true then
        return "enemy"
    end
    if targetAlly == true and targetEnemy ~= true then
        return "ally"
    end

    -- 4) Real Roblox Team / TeamColor, but ONLY when they are non-neutral.
    local nativeRelation = getReliableNativeRelation(plr)
    if nativeRelation then
        return nativeRelation
    end

    -- 5) Shared replicated team identifiers / attributes.
    -- Ignore boolean markers here; explicit booleans were handled above.
    for key, localValue in pairs(selfCustom) do
        local targetValue = targetCustom[key]
        if targetValue and localValue
            and not tostring(localValue):find("bool:", 1, true)
            and not tostring(targetValue):find("bool:", 1, true) then
            return targetValue == localValue and "ally" or "enemy"
        end
    end

    -- Never guess here. Unknown means the round-side resolver has not yet
    -- produced enough evidence; validTarget() will simply reject it while
    -- Team Check is enabled instead of accidentally targeting a teammate.
    return "unknown"
end

local function sameTeam(a, b)
    return getTeamRelation(b) == "ally"
end

local function getPing()
    local ok, value = pcall(function()
        local item = Stats.Network.ServerStatsItem["Data Ping"]
        return math.floor(item:GetValue())
    end)
    if ok then return value end
    return 0
end

local function getKnifeTool()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    local candidates = {}
    if char then
        for _, x in ipairs(char:GetChildren()) do
            if x:IsA("Tool") then table.insert(candidates, x) end
        end
    end
    if backpack then
        for _, x in ipairs(backpack:GetChildren()) do
            if x:IsA("Tool") then table.insert(candidates, x) end
        end
    end
    local best
    local bestScore = -math.huge
    for _, tool in ipairs(candidates) do
        local n = tool.Name:lower()
        local score = 0
        if n:find("knife", 1, true) then score += 100 end
        if n:find("blade", 1, true) then score += 70 end
        if n:find("dagger", 1, true) then score += 60 end
        if tool:FindFirstChildWhichIsA("RemoteEvent", true) then score += 10 end
        if tool:FindFirstChild("Handle") then score += 2 end
        if score > bestScore then
            bestScore = score
            best = tool
        end
    end
    return best
end

local function getTargetPart(plr, preferred)
    local char = plr and plr.Character
    if not char then return nil end
    return char:FindFirstChild(preferred)
        or char:FindFirstChild("Head")
        or char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("HumanoidRootPart")
end

local function worldToScreen(pos)
    local p, onScreen = Camera:WorldToViewportPoint(pos)
    return Vector2.new(p.X, p.Y), onScreen, p.Z
end

local function isExplicitEnemy(plr)
    if not plr or plr == LocalPlayer then return false end
    return getTeamRelation(plr) == "enemy"
end

local function isLikelyDeadOrGhost(plr)
    local char = plr and plr.Character
    if not char or not char.Parent then return true end

    -- The game can leave an old character model replicated for a short time
    -- after elimination. Do a cheap, non-recursive death/ghost check so Aim
    -- never locks onto that stale model.
    local hum = getHumanoid(char)
    if not hum or hum.Parent ~= char then return true end

    local state = hum:GetState()
    if state == Enum.HumanoidStateType.Dead then return true end

    -- Knife Duels may intentionally keep the Roblox Humanoid at 0 while the
    -- real duel HP is replicated elsewhere. Do NOT use Humanoid.Health == 0
    -- as a generic ghost/death test; that was suppressing ESP in round one.

    local deadAttr = false
    local aliveAttr = nil
    pcall(function()
        deadAttr = char:GetAttribute("Dead") == true
            or char:GetAttribute("Died") == true
            or char:GetAttribute("Eliminated") == true
            or char:GetAttribute("IsDead") == true
            or char:GetAttribute("InvisibleAfterDeath") == true
            or plr:GetAttribute("Dead") == true
            or plr:GetAttribute("Died") == true
            or plr:GetAttribute("Eliminated") == true
            or plr:GetAttribute("IsDead") == true
        if char:GetAttribute("Alive") ~= nil then aliveAttr = char:GetAttribute("Alive") end
        if plr:GetAttribute("Alive") ~= nil then aliveAttr = plr:GetAttribute("Alive") end
    end)
    if deadAttr or aliveAttr == false then return true end

    -- Do not trust HumanoidRootPart visibility (it is normally invisible).
    -- Instead inspect a couple of actual body parts. If the core visible body
    -- parts are all fully transparent, this is almost certainly the eliminated
    -- placeholder model the game leaves behind.
    local checked, invisible = 0, 0
    local names = {"Head", "UpperTorso", "Torso", "LowerTorso"}
    for _, name in ipairs(names) do
        local part = char:FindFirstChild(name)
        if part and part:IsA("BasePart") then
            checked += 1
            local tr = part.Transparency
            local ltr = 0
            pcall(function() ltr = part.LocalTransparencyModifier end)
            if tr >= 0.985 or ltr >= 0.985 then
                invisible += 1
            end
        end
    end
    if checked >= 2 and invisible >= checked then
        return true
    end

    return false
end

local function validTarget(plr, teamCheck)
    if not plr or plr == LocalPlayer then return false end
    local char = plr.Character
    if not char or not char.Parent then return false end

    local root = getRoot(plr)
    if not root or not root.Parent then return false end

    if isLikelyDeadOrGhost(plr) then return false end

    -- Do not rely on Humanoid.Health: Knife Duels can keep Roblox HP at 0
    -- while the real duel HP lives elsewhere. Only reject explicit death
    -- markers or a genuinely dead Humanoid state.
    local hum = getHumanoid(char)
    if hum then
        local state = hum:GetState()
        if state == Enum.HumanoidStateType.Dead then return false end
    end

    local deadAttr = false
    pcall(function()
        deadAttr = char:GetAttribute('Dead') == true
            or char:GetAttribute('Died') == true
            or char:GetAttribute('Eliminated') == true
            or plr:GetAttribute('Dead') == true
            or plr:GetAttribute('Died') == true
            or plr:GetAttribute('Eliminated') == true
    end)
    if deadAttr then return false end

    if teamCheck then
        -- With Team Check enabled we only accept a positively confirmed enemy.
        -- This prevents an unresolved teammate/neutral UI card from ever being
        -- painted red or selected by Aimbot while the round is being resolved.
        return getTeamRelation(plr) == "enemy"
    end
    return true
end

local function hasLineOfSight(targetPart, targetPlayer)
    if not targetPart then return false end
    local origin = Camera.CFrame.Position
    local direction = targetPart.Position - origin
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character}
    params.IgnoreWater = true
    local result = Workspace:Raycast(origin, direction, params)
    if not result then return true end
    return result.Instance and result.Instance:IsDescendantOf(targetPlayer.Character)
end

local function getClosestTarget(maxDistance, fov, teamCheck, wallCheck)
    local viewport = Camera.ViewportSize
    local center = Vector2.new(viewport.X / 2, viewport.Y / 2)
    local best, bestScreenDistance = nil, fov or math.huge
    local origin = Camera.CFrame.Position
    for _, plr in ipairs(Players:GetPlayers()) do
        if validTarget(plr, teamCheck) then
            local root = getRoot(plr)
            local part = getTargetPart(plr, Settings.AIM.TargetPart)
            if root and part then
                local dist = (root.Position - origin).Magnitude
                if dist <= maxDistance then
                    local screenPos, onScreen = worldToScreen(part.Position)
                    if onScreen then
                        local delta = (screenPos - center).Magnitude
                        if delta <= bestScreenDistance then
                            if not wallCheck or hasLineOfSight(part, plr) then
                                best = plr
                                bestScreenDistance = delta
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

local function getTargetScreenDistance(plr)
    if not plr then return math.huge end
    local part = getTargetPart(plr, Settings.AIM.TargetPart) or getRoot(plr)
    if not part then return math.huge end
    local pos, onScreen, z = worldToScreen(part.Position)
    if not onScreen or z <= 0 then return math.huge end
    local viewport = Camera.ViewportSize
    local center = Vector2.new(viewport.X/2, viewport.Y/2)
    return (pos-center).Magnitude
end

-- Find the best confirmed enemy other than the current sticky target.
-- This lets Sticky Lock keep its target, but still switch when another enemy
-- becomes substantially closer to the crosshair.
local function getSmartChallenger(current)
    if not Settings.AIM.SmartSwitch then return nil end
    local viewport = Camera.ViewportSize
    local center = Vector2.new(viewport.X/2, viewport.Y/2)
    local origin = Camera.CFrame.Position
    local best, bestDelta = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= current and validTarget(plr, Settings.AIM.TeamCheck) then
            local root = getRoot(plr)
            local part = getTargetPart(plr, Settings.AIM.TargetPart)
            if root and part then
                local dist = (root.Position-origin).Magnitude
                if dist <= Settings.AIM.MaxDistance then
                    local screenPos, onScreen, z = worldToScreen(part.Position)
                    if onScreen and z > 0 then
                        local delta = (screenPos-center).Magnitude
                        if delta <= Settings.AIM.FOV and delta < bestDelta then
                            if not Settings.AIM.WallCheck or hasLineOfSight(part, plr) then
                                best, bestDelta = plr, delta
                            end
                        end
                    end
                end
            end
        end
    end
    return best, bestDelta
end

-- ============================================================
-- LIGHTWEIGHT ESP HEALTH CACHE
-- Never walk every character's descendants from RenderStepped.
-- ============================================================
local EspHealthCache = {stamp = 0, data = {}, refreshing = false}
local ESP_HEALTH_INTERVAL = 0.45
local function refreshEspHealthCache(force)
    local now = os.clock()
    if EspHealthCache.refreshing then return end
    if not force and now - EspHealthCache.stamp < ESP_HEALTH_INTERVAL then return end
    EspHealthCache.refreshing = true
    task.spawn(function()
        local data = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                local char = plr.Character
                if char and char.Parent then
                    local hum = getHumanoid(char)
                    local hp, maxHp, dead, found = getCustomHealthState(plr)
                    if hp == nil and hum then hp, maxHp = hum.Health, hum.MaxHealth end
                    data[plr] = {hp=hp, max=maxHp, dead=dead, found=found}
                end
            end
        end
        EspHealthCache.data = data
        EspHealthCache.stamp = os.clock()
        EspHealthCache.refreshing = false
    end)
end

task.delay(0.85, function() refreshEspHealthCache(true) end)

