local function invalidatePlayerState(plr)
    if AimTarget == plr then
        AimTarget = nil
    end
    destroyEspEntry(plr)
    removeHitbox(plr)
end

local function watchCharacterLifecycle(plr, char)
    if not char then return end
    local hum = getHumanoid(char)
    if hum then
        connect(hum.Died, function()
            invalidatePlayerState(plr)
        end)
        connect(hum.AncestryChanged, function(_, parent)
            if not parent then
                invalidatePlayerState(plr)
            end
        end)
    end
    connect(char.AncestryChanged, function(_, parent)
        if not parent then
            invalidatePlayerState(plr)
        end
    end)
end

local function watchPlayerLifecycle(plr)
    if plr == LocalPlayer then return end
    connect(plr.CharacterRemoving, function(char)
        if AimTarget == plr then AimTarget = nil end
        local e = espEntries[plr]
        if e then hideEsp(e) end
        removeHitbox(plr)
    end)
    connect(plr.CharacterAdded, function(char)
        -- A new character means the old lock must never survive across respawn.
        if AimTarget == plr then AimTarget = nil end
        task.defer(function()
            local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
            if hum then watchCharacterLifecycle(plr, char) end
        end)
    end)
    if plr.Character then
        watchCharacterLifecycle(plr, plr.Character)
    end
end

connect(Players.PlayerRemoving, function(plr)
    invalidatePlayerState(plr)
end)

connect(Players.PlayerAdded, function(plr)
    watchPlayerLifecycle(plr)
end)

for _, plr in ipairs(Players:GetPlayers()) do
    watchPlayerLifecycle(plr)
end

connect(RunService.RenderStepped, function(dt)
    if not Alive then return end
    RenderClock += dt
    HudClock += dt
    FPSFrames += 1
    if HudClock >= 0.5 then
        LiveFPS = math.floor(FPSFrames / HudClock + 0.5)
        FPSFrames = 0
        HudClock = 0
    end

    pcall(renderEsp)
    pcall(updateFOV)

    if RenderClock >= 0.18 then
        RenderClock = 0
        TeamDebugClock += 0.18
        TeamDebugClock = 0
        local char = LocalPlayer.Character
        local hum = getHumanoid(char)
        local teamName = LocalPlayer.Team and LocalPlayer.Team.Name or "No Team"
        local hp = hum and math.floor(hum.Health + 0.5) or 0
        local maxHp = hum and math.floor(hum.MaxHealth + 0.5) or 0
        local tool = getKnifeTool()
        liveText.Text = string.format(
            "TEAM  %s     HP  %d/%d     PING  %d ms     FPS  %d     KNIFE  %s\nAIM  %s     TARGET  %s",
            teamName, hp, maxHp, getPing(), LiveFPS, tool and tool.Name or "NOT FOUND",
            Settings.AIM.Enabled and "ON" or "OFF", AimTarget and (AimTarget.DisplayName or AimTarget.Name) or "—"
        )

        local created = math.max(0, LocalPlayer.AccountAge or 0)
        local createdDate = os.date("%d.%m.%Y", os.time() - created*86400)
        local premium = tostring(LocalPlayer.MembershipType):gsub("Enum.MembershipType.", "")
        statText.Text = string.format(
            "Account age: %d days  •  approx. created: %s\nMembership: %s  •  Locale: %s\nTeam: %s  •  UserId: %d",
            created, createdDate, premium, tostring(LocalPlayer.LocaleId), LocalPlayer.Team and LocalPlayer.Team.Name or "None", LocalPlayer.UserId
        )
    end
end)

