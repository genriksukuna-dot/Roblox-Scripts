-- Drag controller: works with mouse and touch for both the window and the open button.
local draggingMain = false
local dragStartMain, startPosMain
connect(Header.InputBegan, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingMain = true
        dragStartMain = input.Position
        startPosMain = Main.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then draggingMain = false end
        end)
    end
end)
connect(UserInputService.InputChanged, function(input)
    if not draggingMain then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
    local delta = input.Position - dragStartMain
    Main.Position = UDim2.new(startPosMain.X.Scale, startPosMain.X.Offset + delta.X, startPosMain.Y.Scale, startPosMain.Y.Offset + delta.Y)
    Shadow.Position = Main.Position
end)

local draggingFloating = false
local floatingDragged = false
local dragStartFloating, startPosFloating
connect(Floating.InputBegan, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingFloating = true
        floatingDragged = false
        dragStartFloating = input.Position
        startPosFloating = Floating.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                draggingFloating = false
            end
        end)
    end
end)
connect(UserInputService.InputChanged, function(input)
    if not draggingFloating then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
    local delta = input.Position - dragStartFloating
    if delta.Magnitude > 6 then floatingDragged = true end
    Floating.Position = UDim2.new(startPosFloating.X.Scale, startPosFloating.X.Offset + delta.X, startPosFloating.Y.Scale, startPosFloating.Y.Offset + delta.Y)
end)

